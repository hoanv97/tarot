{
  "name": "@miu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --clean --noExternal @miu/tarot-core --noExternal @miu/tarot-data --noExternal @miu/content-policy",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed-content.ts"
  },
  "dependencies": {
    "@miu/content-policy": "workspace:*",
    "@miu/tarot-core": "workspace:*",
    "@miu/tarot-data": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

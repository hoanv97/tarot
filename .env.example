# ---- Supabase (dùng cho web và api) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Chỉ api dùng (xác thực token người dùng); không bao giờ đưa vào web
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dùng cho thao tác quản trị tài khoản và script seed; KHÔNG đưa vào web hay commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- api (Express) ----
PORT=4000
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# (Tùy chọn) chỉ đặt khi đi qua proxy/gateway; mặc định https://api.anthropic.com
# ANTHROPIC_BASE_URL=
# Danh sách origin được phép gọi api, cách nhau bằng dấu phẩy
# Cần có cả địa chỉ web (3000) và trang quản trị (3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Miền ghép sau tên đăng nhập thành email nội bộ (không gửi thư). Đổi nếu Supabase từ chối miền mặc định.
# NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=miutarot.app
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# ---- web (apps/web/.env.local): nối với trang quản trị ----
# Địa chỉ trang quản trị (apps/admin) để hiện liên kết "Quản trị" cho tài khoản admin
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Khóa dùng chung với apps/admin để admin báo web làm mới cache sau khi lưu (đặt cùng giá trị ở cả hai nơi)
# REVALIDATE_SECRET=chuoi-ngau-nhien-dai

# ---- admin (apps/admin/.env.local): chỉ cần khóa anon, không bao giờ đặt service_role ở đây ----
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WEB_URL=http://localhost:3000   # liên kết "Về trang web"
# WEB_URL=http://localhost:3000               # nơi admin gọi để làm mới cache
# REVALIDATE_SECRET=chuoi-ngau-nhien-dai

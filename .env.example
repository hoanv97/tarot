# ---- Supabase (dùng cho web và api) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Chỉ api dùng (xác thực token người dùng); không bao giờ đưa vào web
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dùng cho thao tác quản trị tài khoản và script seed; KHÔNG đưa vào web hay commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- api (Express) ----
PORT=4000
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# (Tùy chọn) chỉ đặt khi đi qua proxy/gateway; mặc định https://api.anthropic.com
# ANTHROPIC_BASE_URL=
# Danh sách origin được phép gọi api, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# ---- web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Miền ghép sau tên đăng nhập thành email nội bộ (không gửi thư). Đổi nếu Supabase từ chối miền mặc định.
# NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=miutarot.app
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
